# Caddy terminates TLS and proxies to the Next.js container.
# Certificates are obtained and renewed from Let's Encrypt automatically —
# requirements: ports 80 and 443 reachable from the internet, and an A record
# for edassets.ezuse.ai pointing at this host.
edassets.ezuse.ai {
	encode zstd gzip
	reverse_proxy app:3000

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
