# ── Dify (Principal Fang 教案 API) — 關鍵字來源 ──
DIFY_BASE=https://dify.lig.com.tw
DIFY_APP_KEY=app-xxxxxxxxxxxxxxxxxxxx

# ── ComfyUI 生圖 (LightEra) ──
COMFY_BASE=https://comfyapi.ezuse.ai
COMFY_API_KEY=                # 由 Henry 發放
COMFY_WORKFLOW_ID=z_image

# ── LiG Cloud 素材庫 ──
LIG_BASE=https://api.lig.com.tw
LIG_EMAIL=henry.lin@lig.com.tw
LIG_PASSWORD=                 # 你的密碼，勿提交

# ── Local Postgres (docker compose, host port 5433) ──
DATABASE_URL=postgres://ar:ar_dev_pw@localhost:5433/ar_assets

# ── OpenAI (關鍵字策展：過濾可3D名詞 + 生圖 prompt) ──
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# ── Tripo3D (image-to-3D) ──
TRIPO_BASE=https://api.tripo3d.ai/v2/openapi
TRIPO_API_KEY=tsk_...

# ── 後台登入（自建 session；lib/auth.ts、lib/session.ts、proxy.ts）──
# 簽 session cookie 用。未設定或短於 16 字元 → 全站 fail closed（沒人進得去）。
# 產生方式：openssl rand -base64 32
AUTH_SECRET=
# 允許註冊的 email 網域，逗號分隔。**留空 = 所有人都不能註冊**（刻意 fail closed）。
AUTH_ALLOWED_EMAIL_DOMAINS=lig.com.tw,ezuse.ai
# 寄密碼重設信 — Google Workspace / Gmail API（服務帳號 + 網域全域委派）
# 整個服務帳號金鑰 JSON 貼成一行。不要提交進 git。
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n", ...}
# 服務帳號代發信的 Workspace 信箱（必須是真實存在的帳號）
GMAIL_SENDER=noreply@ezuse.ai
AUTH_EMAIL_FROM=AR Assets Studio <noreply@ezuse.ai>
# 信件裡連結用的站台網址；未設定則退回 VERCEL_URL 或正式網域
APP_URL=https://edassets.ezuse.ai

# ── /api/migrate 的保護金鑰 ──
# GET /api/migrate?secret=<這個值>。未設定則該端點一律回 401。
MIGRATE_SECRET=
